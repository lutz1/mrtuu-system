rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaffWithAny(perms) {
      return request.auth != null &&
        get(/databases/$(database)/documents/lykas_staff/$(request.auth.uid)).data.permissions.hasAny(perms);
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /user_lookup/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == email;
    }
    match /lykas_staff/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/lykas_staff/$(request.auth.uid)).data.permissions.hasAny(["manage_staff"])
      );
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/lykas_staff/$(request.auth.uid)).data.permissions.hasAny(["manage_staff"]) &&
        request.auth.uid != uid;
    }

    match /lykas_vehicles/{vehicleId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/lykas_staff/$(request.auth.uid)).data.permissions.hasAny(["manage_fleet", "dispatch"]);
    }

    match /lykas_bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isStaffWithAny(["manage_fleet", "dispatch", "clearance_review", "view_reports"])
      );

      allow create: if request.auth != null && (
        request.resource.data.uid == request.auth.uid ||
        (request.resource.data.uid == null && isStaffWithAny(["manage_fleet"]))
      );

      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isStaffWithAny(["manage_fleet", "clearance_review", "dispatch"])
      );
    }

    match /lykas_payments/{paymentId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        isStaffWithAny(["manage_fleet", "clearance_review", "dispatch", "view_reports"])
      );
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /lykas_customers/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isStaffWithAny(["manage_fleet", "view_reports", "clearance_review"])
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /lykas_reports/{reportId} {
      allow read: if isStaffWithAny(["view_reports"]);
      allow create: if isStaffWithAny(["view_reports"]) &&
        request.resource.data.generatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}