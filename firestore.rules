rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /user_lookup/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == email;
    }
    match /lykas_staff/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/lykas_staff/$(request.auth.uid)).data.permissions.hasAny(["manage_staff"])
      );
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/lykas_staff/$(request.auth.uid)).data.permissions.hasAny(["manage_staff"]) &&
        request.auth.uid != uid;
    }

    // NEW — was missing entirely, which caused the "insufficient permissions" errors
    match /lykas_vehicles/{vehicleId} {
      allow read: if true; // public showroom browsing (VehiclesContext) — matches architecture doc Section 6
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/lykas_staff/$(request.auth.uid)).data.permissions.hasAny(["manage_fleet"]);
    }
  }
}