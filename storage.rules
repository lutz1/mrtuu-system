rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /vehicle-images/{vehicleId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /profile-pictures/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /inspection-photos/{bookingId}/{phase}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /reports/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}